{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "imrandevbd/woven-garments-erp",
    "type": "project",
    "description": "Woven Garments ERP — complete modular Laravel 12 + Filament business OS by Imran Ahmed",
    "keywords": [
        "laravel",
        "filament",
        "erp",
        "bangladesh",
        "saas",
        "woven-garments-erp",
        "imrandevbd"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Imran Ahmed",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "me@imrandev.bd",
        "issues": "https://github.com/imranbru99",
        "source": "https://imrandev.bd",
        "docs": "https://imrandev.bd/applications/woven-garments-erp"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3",
        "imrandevbd/drutogoti": "dev-main",
        "imrandevbd/laravel-admin-panel": "dev-main",
        "imrandevbd/laravel-ai-catalog": "dev-main",
        "imrandevbd/laravel-ai-hub": "^1.7",
        "imrandevbd/laravel-attendance-hub": "dev-main",
        "imrandevbd/laravel-unicode-pdf": "dev-main",
        "imrandevbd/laravel-universal-slug": "dev-main",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^3.5",
        "spatie/laravel-permission": "^6.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
